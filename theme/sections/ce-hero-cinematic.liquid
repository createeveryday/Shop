{% comment %}
  Create+Everyday — Cinematic Hero
  ---------------------------------
  Full-bleed hero with autoplay/muted/looped background video (or image),
  gradient scrim, kicker + headline + subheading, up to two CTAs, optional
  slow "Ken Burns" zoom and a scroll cue.

  Self-contained: all styles/scripts are scoped to .ce-hero and bundled by
  Shopify. Safe to add anywhere from the theme editor. Respects
  prefers-reduced-motion and pauses the video when off-screen.

  Media priority: Shopify video > direct MP4 URL > image (poster/fallback).
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign poster = s.image
  if poster == blank and s.video != blank
    assign poster = s.video.preview_image
  endif
-%}

<div
  class="ce-hero color-{{ s.color_scheme }} ce-hero--h-{{ s.height }} ce-hero--x-{{ s.content_x }} ce-hero--y-{{ s.content_y }}{% if s.enable_zoom %} ce-hero--zoom{% endif %}"
  style="--ce-overlay:{{ s.overlay_opacity | divided_by: 100.0 }};--ce-accent:{{ s.accent_color }};"
  data-overlay-style="{{ s.overlay_style }}"
>
  <div class="ce-hero__media" aria-hidden="true">
    {%- if s.video != blank -%}
      <video
        class="ce-hero__video"
        autoplay muted loop playsinline preload="metadata"
        {% if poster != blank %}poster="{{ poster | image_url: width: 1600 }}"{% endif %}
      >
        {%- for source in s.video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
    {%- elsif s.video_url_mp4 != blank -%}
      <video
        class="ce-hero__video"
        autoplay muted loop playsinline preload="metadata"
        {% if poster != blank %}poster="{{ poster | image_url: width: 1600 }}"{% endif %}
      >
        <source src="{{ s.video_url_mp4 }}" type="video/mp4">
      </video>
    {%- endif -%}

    {%- if poster != blank -%}
      {{
        poster
        | image_url: width: 2200
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '600, 900, 1200, 1600, 2000, 2200',
          class: 'ce-hero__image',
          alt: poster.alt | default: s.heading | escape
      }}
    {%- elsif s.video == blank and s.video_url_mp4 == blank -%}
      <div class="ce-hero__image ce-hero__placeholder">
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="ce-hero__overlay" aria-hidden="true"></div>

  <div class="ce-hero__inner page-width">
    <div class="ce-hero__content">
      {%- if s.kicker != blank -%}
        <p class="ce-hero__kicker">{{ s.kicker | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="ce-hero__heading ce-hero__heading--{{ s.heading_size }}">{{ s.heading }}</h2>
      {%- endif -%}

      {%- if s.subheading != blank -%}
        <div class="ce-hero__subheading rte">{{ s.subheading }}</div>
      {%- endif -%}

      {%- if s.button_label_1 != blank or s.button_label_2 != blank -%}
        <div class="ce-hero__actions">
          {%- if s.button_label_1 != blank -%}
            <a
              class="ce-hero__btn button button--primary"
              {% if s.button_link_1 != blank %}href="{{ s.button_link_1 }}"{% else %}role="link" aria-disabled="true"{% endif %}
            >{{ s.button_label_1 | escape }}</a>
          {%- endif -%}
          {%- if s.button_label_2 != blank -%}
            <a
              class="ce-hero__btn button button--secondary"
              {% if s.button_link_2 != blank %}href="{{ s.button_link_2 }}"{% else %}role="link" aria-disabled="true"{% endif %}
            >{{ s.button_label_2 | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if s.show_scroll_cue -%}
    <div class="ce-hero__cue" aria-hidden="true">
      <span class="ce-hero__cue-text">{{ s.scroll_cue_text | escape }}</span>
      <span class="ce-hero__cue-line"></span>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.ce-hero {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  overflow: hidden;
  isolation: isolate;
  color: rgb(var(--color-foreground, 255, 255, 255));
}
.ce-hero--h-small { min-height: 60vh; }
.ce-hero--h-medium { min-height: 75vh; }
.ce-hero--h-large { min-height: 90vh; }
.ce-hero--h-full { min-height: 100vh; min-height: 100svh; }

.ce-hero__media,
.ce-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
}
.ce-hero__video,
.ce-hero__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.ce-hero__placeholder svg { width: 100%; height: 100%; object-fit: cover; }

/* Slow cinematic zoom */
.ce-hero--zoom .ce-hero__video,
.ce-hero--zoom .ce-hero__image {
  animation: ce-hero-zoom 22s ease-out forwards;
}
@keyframes ce-hero-zoom {
  from { transform: scale(1); }
  to { transform: scale(1.12); }
}

/* Overlay / scrim for legibility */
.ce-hero__overlay { background: rgba(0, 0, 0, var(--ce-overlay, 0.45)); }
.ce-hero[data-overlay-style="gradient-bottom"] .ce-hero__overlay {
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, calc(var(--ce-overlay, 0.45) + 0.35)) 0%,
    rgba(0, 0, 0, var(--ce-overlay, 0.45)) 38%,
    rgba(0, 0, 0, 0) 78%
  );
}
.ce-hero[data-overlay-style="vignette"] .ce-hero__overlay {
  background:
    radial-gradient(120% 120% at 50% 50%, rgba(0,0,0,0) 42%, rgba(0,0,0,calc(var(--ce-overlay,0.45) + 0.3)) 100%),
    rgba(0, 0, 0, calc(var(--ce-overlay, 0.45) * 0.5));
}

.ce-hero__inner {
  position: relative;
  z-index: 1;
  width: 100%;
  padding-top: 6rem;
  padding-bottom: 6rem;
  display: flex;
}
.ce-hero--x-left .ce-hero__inner { justify-content: flex-start; }
.ce-hero--x-center .ce-hero__inner { justify-content: center; }
.ce-hero--x-right .ce-hero__inner { justify-content: flex-end; }
.ce-hero--y-top { align-items: flex-start; }
.ce-hero--y-middle { align-items: center; }
.ce-hero--y-bottom { align-items: flex-end; }

.ce-hero__content {
  max-width: 64rem;
  text-align: var(--ce-text-align, left);
}
.ce-hero--x-center .ce-hero__content { text-align: center; }
.ce-hero--x-right .ce-hero__content { text-align: right; }

.ce-hero__kicker {
  margin: 0 0 1.6rem;
  font-size: 1.3rem;
  font-weight: 600;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--ce-accent, #ff5f00);
}
.ce-hero__heading {
  margin: 0;
  line-height: 1.02;
  letter-spacing: -0.01em;
  text-wrap: balance;
  text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
}
.ce-hero__heading--medium { font-size: clamp(3.2rem, 6vw, 6rem); }
.ce-hero__heading--large { font-size: clamp(4rem, 8vw, 8.5rem); }
.ce-hero__heading--xlarge { font-size: clamp(4.8rem, 10vw, 11rem); }

.ce-hero__subheading {
  margin-top: 1.8rem;
  max-width: 52rem;
  font-size: clamp(1.6rem, 2vw, 2rem);
  line-height: 1.5;
  opacity: 0.92;
}
.ce-hero--x-center .ce-hero__subheading { margin-left: auto; margin-right: auto; }
.ce-hero--x-right .ce-hero__subheading { margin-left: auto; }

.ce-hero__actions {
  margin-top: 3.2rem;
  display: flex;
  flex-wrap: wrap;
  gap: 1.4rem;
}
.ce-hero--x-center .ce-hero__actions { justify-content: center; }
.ce-hero--x-right .ce-hero__actions { justify-content: flex-end; }
.ce-hero__btn { min-width: 18rem; }

/* Scroll cue */
.ce-hero__cue {
  position: absolute;
  left: 50%;
  bottom: 2.6rem;
  transform: translateX(-50%);
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}
.ce-hero__cue-text {
  font-size: 1.1rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  opacity: 0.8;
}
.ce-hero__cue-line {
  width: 1px;
  height: 5.5rem;
  background: linear-gradient(to bottom, rgba(255,255,255,0.9), rgba(255,255,255,0));
  transform-origin: top;
  animation: ce-hero-cue 2.2s ease-in-out infinite;
}
@keyframes ce-hero-cue {
  0% { transform: scaleY(0); opacity: 0; }
  40% { transform: scaleY(1); opacity: 1; }
  100% { transform: scaleY(1); opacity: 0; }
}

/* Entrance reveal */
.ce-hero__content > * {
  opacity: 0;
  transform: translateY(2.2rem);
  animation: ce-hero-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
.ce-hero__content > *:nth-child(2) { animation-delay: 0.12s; }
.ce-hero__content > *:nth-child(3) { animation-delay: 0.24s; }
.ce-hero__content > *:nth-child(4) { animation-delay: 0.36s; }
@keyframes ce-hero-in {
  to { opacity: 1; transform: translateY(0); }
}

@media screen and (max-width: 749px) {
  .ce-hero__inner { padding-top: 4rem; padding-bottom: 4rem; }
  .ce-hero__btn { min-width: 100%; }
  .ce-hero--h-full { min-height: 88vh; min-height: 88svh; }
}

@media (prefers-reduced-motion: reduce) {
  .ce-hero--zoom .ce-hero__video,
  .ce-hero--zoom .ce-hero__image,
  .ce-hero__cue-line,
  .ce-hero__content > * {
    animation: none;
  }
  .ce-hero__content > * { opacity: 1; transform: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  var roots = document.querySelectorAll('.ce-hero');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  roots.forEach(function (root) {
    var video = root.querySelector('.ce-hero__video');
    if (!video) return;

    // Honor reduced-motion: don't loop/autoplay aggressively.
    if (reduce) {
      try { video.removeAttribute('autoplay'); video.pause(); } catch (e) {}
      return;
    }

    // Pause when off-screen to save resources.
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            var p = video.play();
            if (p && p.catch) p.catch(function () {});
          } else {
            video.pause();
          }
        });
      }, { threshold: 0.1 });
      io.observe(root);
    }
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Cinematic hero",
  "tag": "section",
  "class": "ce-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Background media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video (Shopify-hosted)",
      "info": "Recommended. Autoplays muted and looped. Use a poster image below as the fallback."
    },
    {
      "type": "text",
      "id": "video_url_mp4",
      "label": "Or direct MP4 URL",
      "info": "Optional. A direct .mp4 link (e.g. a Shopify CDN video URL). Used only if no Shopify video is set."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Poster / fallback image",
      "info": "Shown before the video loads, on reduced-motion, and when no video is set."
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Slow zoom (Ken Burns)",
      "default": true
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "options": [
        { "value": "solid", "label": "Even dim" },
        { "value": "gradient-bottom", "label": "Bottom gradient" },
        { "value": "vignette", "label": "Vignette" }
      ],
      "default": "gradient-bottom"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay strength",
      "default": 45
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (eyebrow)",
      "default": "Create+Everyday"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Built for the drive"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "Extra large" }
      ],
      "default": "large"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Cinematic, high-end automotive design — engineered to feel like motion.</p>"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Kicker accent color",
      "default": "#ff5f00"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Watch the film"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "options": [
        { "value": "small", "label": "Small (60vh)" },
        { "value": "medium", "label": "Medium (75vh)" },
        { "value": "large", "label": "Large (90vh)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "content_x",
      "label": "Horizontal position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_y",
      "label": "Vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Scroll cue"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_cue",
      "label": "Show scroll cue",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_cue_text",
      "label": "Scroll cue text",
      "default": "Scroll"
    }
  ],
  "presets": [
    {
      "name": "Cinematic hero"
    }
  ]
}
{% endschema %}
