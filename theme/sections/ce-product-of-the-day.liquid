{% comment %}
  Create+Everyday — Product of the Day
  Square (1:1) autoplay video on one side, product details on the other.
  Pick a product to auto-fill title / price / description / add-to-cart
  (opens the cart drawer), or use the manual heading/description/button.
  Self-contained styles + script; uses the global editorial tokens.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign prod = s.product
  assign heading = s.heading
  if heading == blank and prod != blank
    assign heading = prod.title
  endif
  assign desc = s.description
  if desc == blank and prod != blank
    assign desc = prod.description
  endif
  assign poster = s.poster
  if poster == blank and prod != blank
    assign poster = prod.featured_image
  endif
  if poster == blank and s.video != blank
    assign poster = s.video.preview_image
  endif
-%}
<section
  class="ce-potd ce-potd--media-{{ s.media_position }} color-{{ s.color_scheme }}"
  {{ section.shopify_attributes }}
>
  <div class="ce-potd__inner">
    <div class="ce-potd__media ce-reveal">
      {%- if s.video != blank -%}
        <video class="ce-potd__video" autoplay muted loop playsinline preload="metadata"
          {% if poster != blank %}poster="{{ poster | image_url: width: 1200 }}"{% endif %}>
          {%- for src in s.video.sources -%}<source src="{{ src.url }}" type="{{ src.mime_type }}">{%- endfor -%}
        </video>
      {%- elsif s.video_url_mp4 != blank -%}
        <video class="ce-potd__video" autoplay muted loop playsinline preload="metadata"
          {% if poster != blank %}poster="{{ poster | image_url: width: 1200 }}"{% endif %}>
          <source src="{{ s.video_url_mp4 }}" type="video/mp4">
        </video>
      {%- elsif poster != blank -%}
        {{ poster | image_url: width: 1400 | image_tag:
          loading: 'lazy', sizes: '(min-width:750px) 50vw, 100vw',
          widths: '500, 800, 1100, 1400', alt: heading | escape }}
      {%- else -%}
        <div class="ce-potd__ph"></div>
      {%- endif -%}
    </div>

    <div class="ce-potd__content ce-reveal" data-delay="1">
      {%- if s.label != blank -%}<span class="ce-label ce-label--accent">{{ s.label | escape }}</span>{%- endif -%}
      {%- if heading != blank -%}<h2 class="ce-potd__heading ce-display">{{ heading | escape }}</h2>{%- endif -%}

      {%- if s.show_price and prod != blank -%}
        <div class="ce-potd__price">
          {{ prod.price | money }}
          {%- if prod.compare_at_price > prod.price -%}<s>{{ prod.compare_at_price | money }}</s>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if desc != blank -%}<div class="ce-potd__desc rte">{{ desc }}</div>{%- endif -%}

      <div class="ce-potd__actions">
        {%- if prod != blank -%}
          {%- if prod.available -%}
            <product-form class="ce-potd__form-wrap" data-section-id="{{ section.id }}">
              {%- form 'product', prod, id: 'potd-form', class: 'ce-potd__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input type="hidden" name="id" value="{{ prod.selected_or_first_available_variant.id }}">
                <button type="submit" name="add" class="ce-btn">{{ s.button_label | default: 'Add to cart' }}</button>
              {%- endform -%}
            </product-form>
          {%- else -%}
            <span class="ce-btn ce-btn--ghost" aria-disabled="true">{{ 'products.product.sold_out' | t }}</span>
          {%- endif -%}
          {%- if s.show_view_link -%}
            <a class="ce-btn ce-btn--ghost" href="{{ prod.url }}">{{ s.view_label | default: 'View details' }}</a>
          {%- endif -%}
        {%- elsif s.button_label != blank and s.button_link != blank -%}
          <a class="ce-btn" href="{{ s.button_link }}">{{ s.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if prod != blank -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% stylesheet %}
.ce-potd { background: var(--ce-bg, #101010); color: var(--ce-fg, #ededea); padding: clamp(4rem, 8vh, 9rem) var(--ce-gutter, 2rem); }
.ce-potd__inner { max-width: var(--ce-maxw, 150rem); margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.4rem, 5vw, 7rem); align-items: center; }
.ce-potd__media { position: relative; aspect-ratio: 1 / 1; overflow: hidden; background: #1c1c1c; }
.ce-potd__media img, .ce-potd__media video, .ce-potd__ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
.ce-potd__ph { background: linear-gradient(135deg, #232323, #141414); }
.ce-potd--media-right .ce-potd__media { order: 2; }
.ce-potd__content { display: flex; flex-direction: column; gap: 1.6rem; }
.ce-potd__heading { margin: 0; font-size: clamp(2.6rem, 4vw, 5rem); }
.ce-potd__price { font-family: var(--ce-mono, monospace); letter-spacing: .05em; font-size: clamp(1.6rem, 1.8vw, 2.1rem); }
.ce-potd__price s { opacity: .5; margin-left: 1rem; }
.ce-potd__desc { color: var(--ce-fg-dim, rgba(237,237,234,.62)); line-height: 1.7; max-width: 48rem; }
.ce-potd__desc > * { margin: 0 0 1rem; }
.ce-potd__actions { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 1rem; align-items: center; }
.ce-potd__form, .ce-potd__form-wrap { margin: 0; }
@media screen and (max-width: 749px) {
  .ce-potd__inner { grid-template-columns: 1fr; }
  .ce-potd--media-right .ce-potd__media { order: 0; }
}
@media (prefers-reduced-motion: reduce) { .ce-potd__media video { display: none; } }
{% endstylesheet %}

{% javascript %}
(function () {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function init() {
    document.querySelectorAll('.ce-potd__video').forEach(function (v) {
      if (v.dataset.potdReady) return;
      v.dataset.potdReady = '1';
      if (reduce) { try { v.removeAttribute('autoplay'); v.pause(); } catch (e) {} return; }
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { var p = e.target.play(); if (p && p.catch) p.catch(function () {}); }
            else { e.target.pause(); }
          });
        }, { threshold: 0.1 }).observe(v);
      }
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('shopify:section:load', init);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Product of the day",
  "tag": "section",
  "class": "ce-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow label", "default": "Product of the Day" },
    { "type": "product", "id": "product", "label": "Product", "info": "Auto-fills title, price, description and add-to-cart." },
    { "type": "header", "content": "Square video (1:1)" },
    { "type": "video", "id": "video", "label": "Video (Shopify-hosted)", "info": "Autoplays muted and looped. Shown square." },
    { "type": "text", "id": "video_url_mp4", "label": "Or direct MP4 URL" },
    { "type": "image_picker", "id": "poster", "label": "Poster / fallback image", "info": "Used as the video poster, or shown if no video is set. Defaults to the product image." },
    { "type": "header", "content": "Content (overrides)" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the product title." },
    { "type": "richtext", "id": "description", "label": "Description", "info": "Leave blank to use the product description." },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "text", "id": "button_label", "label": "Add-to-cart button label", "default": "Add to cart" },
    { "type": "checkbox", "id": "show_view_link", "label": "Show \"View details\" link", "default": true },
    { "type": "text", "id": "view_label", "label": "View link label", "default": "View details" },
    { "type": "url", "id": "button_link", "label": "Button link (no-product fallback)" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "media_position", "label": "Video position", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" }
  ],
  "presets": [{ "name": "Product of the day" }]
}
{% endschema %}
