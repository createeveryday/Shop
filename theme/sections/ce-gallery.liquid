{% comment %}
  Create+Everyday — Visual gallery (coverflow carousel)
  Centered enlarged slide with peeking neighbours, category filter chips,
  prev/next arrows, swipe/drag, and inline video playback. Rendered in the
  editorial theme. Self-contained styles + script below.
{% endcomment %}
{%- liquid
  assign s = section.settings
-%}
<section class="ce-gallery" data-ce-gallery {{ section.shopify_attributes }}>
  <div class="ce-gallery__head">
    {%- if s.label != blank -%}<span class="ce-label ce-label--accent ce-reveal">{{ s.label | escape }}</span>{%- endif -%}
    {%- if s.show_instagram and s.instagram_url != blank -%}
      <a class="ce-gallery__insta ce-reveal" href="{{ s.instagram_url }}" target="_blank" rel="noopener" aria-label="Follow on Instagram" data-delay="1">
        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="48" height="48" viewBox="0 0 264.5833 264.5833" aria-hidden="true" focusable="false"><defs><radialGradient id="ceg-f" cx="158.429" cy="578.088" r="52.3515" xlink:href="#ceg-a" gradientUnits="userSpaceOnUse" gradientTransform="matrix(0 -4.03418 4.28018 0 -2332.2273 942.2356)"/><radialGradient xlink:href="#ceg-b" id="ceg-g" gradientUnits="userSpaceOnUse" gradientTransform="matrix(.67441 -1.16203 1.51283 .87801 -814.3657 -47.8354)" cx="172.6149" cy="600.6924" r="65"/><radialGradient xlink:href="#ceg-c" id="ceg-h" cx="144.012" cy="51.3367" r="67.081" gradientTransform="matrix(-2.3989 .67549 -.23008 -.81732 464.9957 -26.4035)" gradientUnits="userSpaceOnUse"/><radialGradient xlink:href="#ceg-d" id="ceg-e" gradientUnits="userSpaceOnUse" gradientTransform="matrix(-3.10797 .87652 -.6315 -2.23914 1345.6503 1374.1983)" cx="199.7884" cy="628.4379" r="52.3515"/><linearGradient id="ceg-d"><stop offset="0" stop-color="#ff005f"/><stop offset="1" stop-color="#fc01d8"/></linearGradient><linearGradient id="ceg-c"><stop offset="0" stop-color="#780cff"/><stop stop-color="#820bff" offset="1" stop-opacity="0"/></linearGradient><linearGradient id="ceg-b"><stop offset="0" stop-color="#fc0"/><stop offset="1" stop-color="#fc0" stop-opacity="0"/></linearGradient><linearGradient id="ceg-a"><stop offset="0" stop-color="#fc0"/><stop offset=".1242" stop-color="#fc0"/><stop offset=".5672" stop-color="#fe4a05"/><stop offset=".6942" stop-color="#ff0f3f"/><stop offset="1" stop-color="#fe0657" stop-opacity="0"/></linearGradient></defs><g><path d="M204.1503 18.1429c-55.2305 0-71.3834.057-74.5232.3175-11.3342.9424-18.387 2.7275-26.0708 6.554-5.9214 2.9413-10.5915 6.3506-15.2005 11.1298-8.3938 8.7157-13.481 19.4383-15.3226 32.1842-.8953 6.1877-1.1558 7.4496-1.2087 39.0558-.0203 10.5354 0 24.4007 0 42.9984 0 55.2008.061 71.3418.3256 74.4764.9157 11.032 2.6453 17.9728 6.3081 25.565 7 14.5329 20.369 25.4428 36.1