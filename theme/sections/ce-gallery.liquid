    { "type": "url", "id": "instagram_url", "label": "Instagram profile URL" },
    { "type": "header", "content": "Filters" },
    { "type": "checkbox", "id": "show_filters", "label": "Show category chips", "default": true },
    { "type": "text", "id": "all_label", "label": "\"All\" chip label", "default": "All" },
    { "type": "text", "id": "more_label", "label": "Extra button label", "default": "View More" },
    { "type": "url", "id": "more_link", "label": "Extra button link" }
