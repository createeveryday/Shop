8.9535-.4214 14.1526-1.1195 19.9011-2.6054 15.8517-4.0912 28.9767-14.8383 36.119-29.5748 3.5916-7.409 5.4128-14.6144 6.237-25.0704.179-2.2796.2543-38.6263.2543-74.924 0-36.304-.0814-72.5835-.2605-74.8632-.8343-10.6249-2.6555-17.7692-6.363-25.3207-3.0421-6.1816-6.42-10.798-11.324-15.518-8.752-8.3616-19.4555-13.4502-32.2101-15.2902-6.18-.8936-7.411-1.1582-39.033-1.2131z" fill="url(#ceg-g)" transform="translate(-71.8155 -18.1429)"/><path d="M204.1503 18.1429c-55.2305 0-71.3834.057-74.5232.3175-11.3342.9424-18.387 2.7275-26.0708 6.554-5.9214 2.9413-10.5915 6.3506-15.2005 11.1298-8.3938 8.7157-13.481 19.4383-15.3226 32.1842-.8953 6.1877-1.1558 7.4496-1.2087 39.0558-.0203 10.5354 0 24.4007 0 42.9984 0 55.2008.061 71.3418.3256 74.4764.9157 11.032 2.6453 17.9728 6.3081 25.565 7 14.5329 20.369 25.4428 36.119 29.5137 5.4535 1.4044 11.4767 2.1779 19.2092 2.5442 3.2762.1425 36.6684.2443 70.081.2443 33.4127 0 66.8253-.0407 70.02-.2035 8.9535-.4214 14.1526-1.1195 19.9011-2.6054 15.8517-4.0912 28.9767-14.8383 36.119-29.5748 3.5916-7.409 5.4128-14.6144 6.237-25.0704.179-2.2796.2543-38.6263.2543-74.924 0-36.304-.0814-72.5835-.2605-74.8632-.8343-10.6249-2.6555-17.7692-6.363-25.3207-3.0421-6.1816-6.42-10.798-11.324-15.518-8.752-8.3616-19.4555-13.4502-32.2101-15.2902-6.18-.8936-7.411-1.1582-39.033-1.2131z" fill="url(#ceg-h)" transform="translate(-71.8155 -18.1429)"/><path d="M132.3452 33.973c-26.7167 0-30.0696.1167-40.5629.5939-10.4727.4792-17.6212 2.136-23.8762 4.567-6.4701 2.5107-11.9586 5.8693-17.4265 11.3352-5.472 5.464-8.8332 10.9483-11.354 17.4116-2.4389 6.2524-4.099 13.3976-4.5703 23.8585-.4693 10.4854-.5923 13.8379-.5923 40.5348 0 26.697.1189 30.0371.5943 40.5225.4817 10.465 2.1397 17.6082 4.5703 23.8585 2.5147 6.4654 5.8758 11.9497 11.3458 17.4136 5.466 5.468 10.9544 8.8349 17.4204 11.3456 6.259 2.4309 13.4097 4.0877 23.8803 4.567 10.4933.477 13.8441.5938 40.5588.5938 26.7188 0 30.0615-.1167 40.5547-.5939 10.4728-.4792 17.6295-2.136 23.8885-4.567 6.4681-2.5106 11.9484-5.8775 17.4143-11.3455 5.472-5.4639 8.8332-10.9482 11.354-17.4115 2.4183-6.2524 4.0784-13.3976 4.5703-23.8585.4713-10.4854.5943-13.8277.5943-40.5246 0-26.697-.123-30.0473-.5943-40.5328-.4919-10.465-2.152-17.6081-4.5703-23.8584-2.5208-6.4654-5.882-11.9498-11.354-17.4137-5.4721-5.468-10.9442-8.8266-17.4204-11.3353-6.2714-2.4309-13.424-4.0877-23.8967-4.5669-10.4933-.4772-13.8339-.5939-40.5588-.5939zm-8.825 17.7147c2.6193-.0041 5.5418 0 8.825 0 26.2659 0 29.379.0942 39.7513.5652 9.5915.4383 14.7971 2.0397 18.2648 3.3852 4.5908 1.7817 7.8638 3.9116 11.3048 7.3521 3.4431 3.4406 5.5745 6.7173 7.3617 11.3046 1.3465 3.461 2.9512 8.6628 3.3877 18.2472.4714 10.3625.5739 13.4754.5739 39.7095 0 26.234-.1025 29.347-.5739 39.7095-.4386 9.5843-2.0412 14.7861-3.3877 18.2471-1.783 4.5874-3.9186 7.8539-7.3617 11.2923-3.443 3.4406-6.712 5.5704-11.3048 7.3521-3.4636 1.3517-8.6733 2.949-18.2648 3.3873-10.3702.471-13.4854.5734-39.7513.5734-26.2679 0-29.381-.1024-39.7513-.5734-9.5914-.4423-14.797-2.0438-18.2668-3.3893-4.5908-1.7817-7.87-3.9116-11.313-7.3521-3.4431-3.4405-5.5745-6.709-7.3617-11.2985-1.3465-3.461-2.9512-8.6628-3.3877-18.2471-.4714-10.3626-.5657-13.4754-.5657-39.7259 0-26.2504.0943-29.347.5657-39.7095.4386-9.5844 2.0412-14.7861 3.3877-18.2512 1.783-4.5874 3.9186-7.8641 7.3617-11.3046 3.443-3.4406 6.7222-5.5704 11.313-7.3562 3.4677-1.3517 8.6754-2.949 18.2668-3.3894 9.075-.4096 12.5919-.5324 30.9264-.553zm61.3363 16.322c-6.5173 0-11.805 5.2776-11.805 11.792 0 6.5125 5.2877 11.7962 11.805 11.7962 6.5172 0 11.8049-5.2837 11.8049-11.7962 0-6.5124-5.2877-11.796-11.805-11.796zm-52.5113 13.7826c-27.8993 0-50.5191 22.6031-50.5191 50.4817 0 27.8786 22.6198 50.4714 50.5191 50.4714s50.511-22.5928 50.511-50.4714c0-27.8786-22.6137-50.4817-50.513-50.4817zm0 17.7147c18.109 0 32.7914 14.6694 32.7914 32.767 0 18.0956-14.6824 32.767-32.7914 32.767-18.111 0-32.7913-14.6714-32.7913-32.767 0-18.0976 14.6803-32.767 32.7913-32.767z" fill="#fff"/></g></svg>
      </a>
    {%- endif -%}
    {%- if s.heading != blank -%}<h2 class="ce-gallery__heading ce-display ce-reveal" data-delay="2">{{ s.heading | escape }}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="ce-gallery__sub ce-reveal" data-delay="3">{{ s.subheading | escape }}</p>{%- endif -%}
  </div>

  {%- if s.show_filters and section.blocks.size > 0 -%}
    {%- assign seen = '' -%}
    <div class="ce-gallery__chips ce-reveal">
      <button class="ce-chip is-active" type="button" data-filter="*">{{ s.all_label | default: 'All' }}</button>
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.category | strip -%}
        {%- if c != blank -%}
          {%- assign ch = c | handleize -%}
          {%- assign key = '|' | append: ch | append: '|' -%}
          {%- unless seen contains key -%}
            {%- assign seen = seen | append: key -%}
            <button class="ce-chip" type="button" data-filter="{{ ch }}">{{ c | escape }}</button>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if s.more_label != blank -%}
        <a class="ce-btn ce-gallery__more" {% if s.more_link != blank %}href="{{ s.more_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
          {{ s.more_label | escape }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="ce-gallery__viewport" data-viewport>
    <div class="ce-gallery__track" data-track>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign has_video = false -%}
        {%- if b.video != blank or b.external_video != blank -%}{%- assign has_video = true -%}{%- endif -%}
        <article class="ce-gallery__slide" data-cat="{{ b.category | handleize }}"
          data-full="{% if b.image != blank %}{{ b.image | image_url: width: 2000 }}{% endif %}"
          data-loc="{{ b.category | escape }}" data-caption="{{ b.title | escape }}"
          {{ block.shopify_attributes }}>
          <div class="ce-gallery__card">
            <div class="ce-gallery__media">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 1400 | image_tag:
                  loading: 'lazy', sizes: '(min-width:750px) 42rem, 80vw',
                  widths: '400, 700, 1000, 1400', alt: b.title | default: b.category | escape }}
              {%- else -%}
                <div class="ce-gallery__ph"></div>
              {%- endif -%}
            </div>

            {%- if has_video -%}
              <button class="ce-gallery__play" type="button" aria-label="Play video">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </button>
              <div class="ce-gallery__player" data-player hidden>
                <video class="ce-gallery__video" controls playsinline preload="none"
                  {% if b.image != blank %}poster="{{ b.image | image_url: width: 1000 }}"{% endif %}>
                  {%- if b.video != blank -%}
                    {%- for src in b.video.sources -%}<source src="{{ src.url }}" type="{{ src.mime_type }}">{%- endfor -%}
                  {%- elsif b.external_video != blank -%}
                    <source src="{{ b.external_video }}" type="video/mp4">
                  {%- endif -%}
                </video>
              </div>
            {%- endif -%}

            {%- if b.title != blank or b.category != blank -%}
              <div class="ce-gallery__cap">
                {%- if b.category != blank -%}<span class="ce-label">{{ b.category | escape }}</span>{%- endif -%}
                {%- if b.title != blank -%}<p class="ce-gallery__title">{{ b.title | escape }}</p>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>

  <div class="ce-gallery__nav">
    <button class="ce-gallery__arrow" type="button" data-prev aria-label="Previous">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 12H5m0 0 6-6m-6 6 6 6" stroke="currentColor" stroke-width="2"/></svg>
    </button>
    <button class="ce-gallery__arrow" type="button" data-next aria-label="Next">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2"/></svg>
    </button>
  </div>

  <div class="ce-gallery__lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Gallery viewer">
    <button class="ce-gallery__lb-close" type="button" data-lb-close aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2"/></svg>
    </button>
    <button class="ce-gallery__lb-arrow ce-gallery__lb-arrow--prev" type="button" data-lb-prev aria-label="Previous">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2"/></svg>
    </button>
    <button class="ce-gallery__lb-arrow ce-gallery__lb-arrow--next" type="button" data-lb-next aria-label="Next">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2"/></svg>
    </button>
    <figure class="ce-gallery__lb-figure">
      <div class="ce-gallery__lb-media" data-lb-media></div>
      <figcaption class="ce-gallery__lb-cap" data-lb-cap></figcaption>
    </figure>
  </div>
</section>

{% stylesheet %}
.ce-gallery { background: var(--ce-bg, #101010); color: var(--ce-fg, #ededea); padding: clamp(4rem, 8vh, 9rem) 0; overflow: hidden; }
.ce-gallery__head { text-align: center; max-width: 70rem; margin: 0 auto clamp(2.2rem, 4vw, 3.4rem); padding: 0 var(--ce-gutter, 2rem); }
.ce-gallery__head .ce-label { display: block; margin-bottom: 1.2rem; }
.ce-gallery__insta { display: inline-block; margin-bottom: 2rem; line-height: 0; transition: transform .25s, opacity .25s; }
.ce-gallery__insta:hover { transform: scale(1.1); opacity: .85; }
.ce-gallery__heading { margin: 0; font-size: clamp(3rem, 5vw, 6rem); }
.ce-gallery__sub { margin: 1.6rem 0 0; color: var(--ce-fg-dim, rgba(237,237,234,.58)); font-size: clamp(1.5rem, 1.4vw, 1.8rem); line-height: 1.6; }

.ce-gallery__chips { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1rem; padding: 0 var(--ce-gutter, 2rem); margin-bottom: clamp(2.4rem, 4vw, 4rem); }
.ce-chip { font-family: var(--ce-mono, monospace); text-transform: uppercase; letter-spacing: 0.12em; font-size: 1.15rem; font-weight: 700; padding: 1.1rem 1.8rem; border: 1px solid var(--ce-line, rgba(237,237,234,.14)); background: transparent; color: var(--ce-fg, #ededea); cursor: pointer; transition: color .25s, border-color .25s, background .25s; }
.ce-chip:hover { border-color: var(--ce-accent, #ff5f00); color: var(--ce-accent, #ff5f00); }
.ce-chip.is-active { background: var(--ce-fg, #ededea); color: var(--ce-ink, #0e0e0e); border-color: var(--ce-fg, #ededea); }
.ce-gallery__more { margin-left: 0.6rem; }

.ce-gallery__viewport { width: 100%; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; cursor: grab; }
.ce-gallery__viewport::-webkit-scrollbar { display: none; }
.ce-gallery__viewport.is-dragging { cursor: grabbing; scroll-snap-type: none; }
.ce-gallery__track { display: flex; gap: clamp(1.2rem, 2vw, 2.4rem); width: max-content; padding: 2rem max(var(--ce-gutter, 2rem), calc(50vw - 21rem)); }
.ce-gallery__slide { scroll-snap-align: center; flex: 0 0 auto; width: min(80vw, 42rem); }
.ce-gallery__slide[hidden] { display: none; }
.ce-gallery__card { position: relative; aspect-ratio: 4 / 5; overflow: hidden; transform: scale(.85); opacity: .5; transition: transform .55s cubic-bezier(.22,1,.36,1), opacity .55s; box-shadow: 0 3rem 6rem rgba(0,0,0,.5); }
.ce-gallery__slide.is-center .ce-gallery__card { transform: scale(1); opacity: 1; }
.ce-gallery__media, .ce-gallery__media img, .ce-gallery__ph, .ce-gallery__player, .ce-gallery__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.ce-gallery__ph { background: linear-gradient(135deg, #232323, #141414); }
.ce-gallery__cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 1.8rem 2rem; background: linear-gradient(transparent, rgba(0,0,0,.72)); z-index: 2; }
.ce-gallery__cap .ce-label { color: #fff; opacity: .85; }
.ce-gallery__title { font-family: var(--ce-display, sans-serif); font-weight: 800; text-transform: uppercase; letter-spacing: -0.01em; color: #fff; margin: .4rem 0 0; font-size: clamp(1.7rem, 1.8vw, 2.2rem); line-height: 1.04; }
.ce-gallery__play { position: absolute; inset: 0; margin: auto; width: 6.4rem; height: 6.4rem; display: grid; place-items: center; border-radius: 50%; background: rgba(0,0,0,.42); border: 1px solid rgba(255,255,255,.65); color: #fff; cursor: pointer; z-index: 3; transition: background .25s, transform .25s; }
.ce-gallery__play:hover { background: var(--ce-accent, #ff5f00); transform: scale(1.06); border-color: transparent; }
.ce-gallery__player { z-index: 4; background: #000; }
.ce-gallery__nav { display: flex; justify-content: center; gap: 1.4rem; margin-top: clamp(2.2rem, 4vw, 3.4rem); }
.ce-gallery__arrow { width: 5.2rem; height: 5.2rem; border-radius: 50%; border: 1px solid var(--ce-line, rgba(237,237,234,.18)); background: transparent; color: var(--ce-fg, #ededea); cursor: pointer; display: grid; place-items: center; transition: color .25s, border-color .25s; }
.ce-gallery__arrow:hover { border-color: var(--ce-accent, #ff5f00); color: var(--ce-accent, #ff5f00); }
@media screen and (max-width: 749px) {
  .ce-gallery__slide { width: 78vw; }
  .ce-gallery__track { padding-left: 11vw; padding-right: 11vw; }
}
@media (prefers-reduced-motion: reduce) {
  .ce-gallery__viewport { scroll-behavior: auto; }
  .ce-gallery__card { transition: none; }
}

/* Lightbox */
.ce-gallery__card { cursor: pointer; }
.ce-gallery__lightbox { position: fixed; inset: 0; z-index: 99999; display: flex; align-items: center; justify-content: center; padding: clamp(2rem, 5vw, 6rem); background: rgba(8,8,8,.94); }
.ce-gallery__lightbox[hidden] { display: none; }
.ce-gallery__lb-figure { margin: 0; max-width: 92vw; display: flex; flex-direction: column; gap: 1.6rem; align-items: center; }
.ce-gallery__lb-media { display: flex; align-items: center; justify-content: center; }
.ce-gallery__lb-media img, .ce-gallery__lb-media video { max-width: 92vw; max-height: 80vh; width: auto; height: auto; object-fit: contain; display: block; box-shadow: 0 4rem 8rem rgba(0,0,0,.6); }
.ce-gallery__lb-cap { display: flex; flex-direction: column; gap: .5rem; text-align: center; color: var(--ce-fg, #ededea); }
.ce-gallery__lb-cap .ce-label { color: var(--ce-accent, #ff5f00); }
.ce-gallery__lb-title { font-family: var(--ce-display, sans-serif); text-transform: uppercase; font-weight: 800; letter-spacing: -0.01em; font-size: clamp(1.8rem, 2.4vw, 3rem); }
.ce-gallery__lb-close { position: absolute; top: clamp(1.4rem, 3vw, 2.6rem); right: clamp(1.4rem, 3vw, 2.6rem); width: 4.8rem; height: 4.8rem; border-radius: 50%; border: 1px solid var(--ce-line, rgba(237,237,234,.2)); background: transparent; color: var(--ce-fg, #ededea); cursor: pointer; display: grid; place-items: center; transition: color .25s, border-color .25s; }
.ce-gallery__lb-close:hover { border-color: var(--ce-accent, #ff5f00); color: var(--ce-accent, #ff5f00); }
.ce-gallery__lb-arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 5.2rem; height: 5.2rem; border-radius: 50%; border: 1px solid var(--ce-line, rgba(237,237,234,.2)); background: rgba(0,0,0,.3); color: var(--ce-fg, #ededea); cursor: pointer; display: grid; place-items: center; transition: color .25s, border-color .25s; }
.ce-gallery__lb-arrow:hover { border-color: var(--ce-accent, #ff5f00); color: var(--ce-accent, #ff5f00); }
.ce-gallery__lb-arrow--prev { left: clamp(1rem, 3vw, 3rem); }
.ce-gallery__lb-arrow--next { right: clamp(1rem, 3vw, 3rem); }
@media screen and (max-width: 749px) { .ce-gallery__lb-arrow { width: 4.2rem; height: 4.2rem; } }
{% endstylesheet %}

{% javascript %}
(function () {
  function initGallery(root) {
    if (root.dataset.galleryReady) return;
    root.dataset.galleryReady = '1';
    var vp = root.querySelector('[data-viewport]');
    var track = root.querySelector('[data-track]');
    if (!vp || !track) return;
    var slides = Array.prototype.slice.call(track.querySelectorAll('.ce-gallery__slide'));
    var raf = null;

    function visible() { return slides.filter(function (s) { return !s.hidden; }); }

    function update() {
      raf = null;
      var vpRect = vp.getBoundingClientRect();
      var center = vpRect.left + vpRect.width / 2;
      var best = null, bestDist = Infinity;
      visible().forEach(function (s) {
        var r = s.getBoundingClientRect();
        var d = Math.abs((r.left + r.width / 2) - center);
        if (d < bestDist) { bestDist = d; best = s; }
      });
      slides.forEach(function (s) { s.classList.toggle('is-center', s === best); });
    }
    function onScroll() { if (!raf) raf = requestAnimationFrame(update); }
    vp.addEventListener('scroll', onScroll, { passive: true });

    function scrollToSlide(s, smooth) {
      if (!s) return;
      var vpRect = vp.getBoundingClientRect();
      var r = s.getBoundingClientRect();
      var delta = (r.left + r.width / 2) - (vpRect.left + vpRect.width / 2);
      vp.scrollTo({ left: vp.scrollLeft + delta, behavior: smooth === false ? 'auto' : 'smooth' });
    }

    function step(dir) {
      var vis = visible();
      var current = vis.indexOf(track.querySelector('.ce-gallery__slide.is-center'));
      if (current < 0) current = 0;
      var next = Math.min(Math.max(current + dir, 0), vis.length - 1);
      scrollToSlide(vis[next]);
    }
    var prev = root.querySelector('[data-prev]');
    var next = root.querySelector('[data-next]');
    if (prev) prev.addEventListener('click', function () { step(-1); });
    if (next) next.addEventListener('click', function () { step(1); });

    /* Category filter chips */
    root.querySelectorAll('.ce-chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        root.querySelectorAll('.ce-chip').forEach(function (c) { c.classList.remove('is-active'); });
        chip.classList.add('is-active');
        var f = chip.getAttribute('data-filter');
        slides.forEach(function (s) {
          s.hidden = !(f === '*' || s.getAttribute('data-cat') === f);
        });
        var vis = visible();
        if (vis.length) scrollToSlide(vis[0], false);
        update();
      });
    });

    /* Lightbox */
    var lb = root.querySelector('[data-lightbox]');
    var lbMedia = lb ? lb.querySelector('[data-lb-media]') : null;
    var lbCap = lb ? lb.querySelector('[data-lb-cap]') : null;
    var lbList = [], lbIdx = 0;

    function esc(t) { var d = document.createElement('div'); d.textContent = t || ''; return d.innerHTML; }

    function lbRender() {
      var slide = lbList[lbIdx];
      if (!slide || !lbMedia) return;
      lbMedia.innerHTML = '';
      var srcVideo = slide.querySelector('.ce-gallery__video');
      if (srcVideo) {
        var v = srcVideo.cloneNode(true);
        v.removeAttribute('hidden');
        v.setAttribute('controls', ''); v.setAttribute('playsinline', ''); v.setAttribute('autoplay', '');
        lbMedia.appendChild(v);
        var pl = v.play(); if (pl && pl.catch) pl.catch(function () {});
      } else {
        var img = document.createElement('img');
        var pic = slide.querySelector('img');
        img.src = slide.getAttribute('data-full') || (pic ? (pic.currentSrc || pic.src) : '');
        img.alt = slide.getAttribute('data-caption') || '';
        lbMedia.appendChild(img);
      }
      var loc = slide.getAttribute('data-loc') || '';
      var cap = slide.getAttribute('data-caption') || '';
      lbCap.innerHTML = (loc ? '<span class="ce-label">' + esc(loc) + '</span>' : '') +
                        (cap ? '<span class="ce-gallery__lb-title">' + esc(cap) + '</span>' : '');
    }
    function lbOpen(slide) {
      if (!lb) return;
      lbList = visible();
      lbIdx = lbList.indexOf(slide);
      if (lbIdx < 0) lbIdx = 0;
      lb.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      lbRender();
    }
    function lbClose() {
      if (!lb) return;
      lb.hidden = true;
      document.documentElement.style.overflow = '';
      if (lbMedia) lbMedia.innerHTML = '';
    }
    function lbStep(d) { if (!lbList.length) return; lbIdx = (lbIdx + d + lbList.length) % lbList.length; lbRender(); }

    if (lb) {
      lb.querySelector('[data-lb-close]').addEventListener('click', lbClose);
      lb.querySelector('[data-lb-prev]').addEventListener('click', function () { lbStep(-1); });
      lb.querySelector('[data-lb-next]').addEventListener('click', function () { lbStep(1); });
      lb.addEventListener('click', function (e) { if (e.target === lb) lbClose(); });
      document.addEventListener('keydown', function (e) {
        if (lb.hidden) return;
        if (e.key === 'Escape') lbClose();
        else if (e.key === 'ArrowLeft') lbStep(-1);
        else if (e.key === 'ArrowRight') lbStep(1);
      });
    }

    /* Pointer drag to scroll */
    var down = false, startX = 0, startScroll = 0, moved = false;
    vp.addEventListener('pointerdown', function (e) {
      down = true; moved = false; startX = e.clientX; startScroll = vp.scrollLeft; vp.classList.add('is-dragging');
    });
    vp.addEventListener('pointermove', function (e) {
      if (!down) return;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      vp.scrollLeft = startScroll - dx;
    });
    function endDrag() {
      if (!down) return;
      down = false; vp.classList.remove('is-dragging');
      var c = track.querySelector('.ce-gallery__slide.is-center');
      if (c) scrollToSlide(c);
    }
    vp.addEventListener('pointerup', endDrag);
    vp.addEventListener('pointerleave', endDrag);
    vp.addEventListener('click', function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);

    /* Open lightbox on slide tap (ignored after a drag) */
    slides.forEach(function (slide) {
      var card = slide.querySelector('.ce-gallery__card');
      if (card) card.addEventListener('click', function () { if (!moved) lbOpen(slide); });
    });

    /* Center the middle slide on load */
    var vis = visible();
    if (vis.length) scrollToSlide(vis[Math.floor(vis.length / 2)], false);
    requestAnimationFrame(update);
    window.addEventListener('resize', update);
  }

  function initAll() { document.querySelectorAll('[data-ce-gallery]').forEach(initGallery); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAll);
  else initAll();
  document.addEventListener('shopify:section:load', initAll);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Visual gallery",
  "tag": "section",
  "class": "ce-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow label", "default": "Gallery" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "My Visual Diary" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "See the world through my lens: adventures in photos and videos." },
    { "type": "header", "content": "Instagram" },
