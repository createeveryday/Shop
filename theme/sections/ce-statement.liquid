{% comment %}
  Create+Everyday — Statement panel (Agentura hallmark)
  Full-bleed grayscale image with a paper panel overlapping its base:
  mono index + caption on the left, big display word + small label on
  the right. Editor-configurable. Self-contained styles live in
  assets/ce-agentura.css.
{% endcomment %}
{%- liquid
  assign s = section.settings
-%}
<section class="ce-statement{% unless s.carousel_ratio == 'default' %} ce-statement--ratio-{{ s.carousel_ratio }}{% endunless %}" {{ section.shopify_attributes }}>
  <div class="ce-statement__media ce-reveal{% if s.image_fit == 'contain' %} ce-statement__media--contain{% endif %}">
    {%- if section.blocks.size > 0 -%}
      <div class="ce-statement__carousel" data-st-carousel data-autoplay="{{ s.autoplay_speed }}">
        <div class="ce-statement__track" data-st-track>
          {%- for block in section.blocks -%}
            {%- liquid
              assign focal = block.settings.focal | default: 'center'
              if focal == 'manual'
                assign pos = block.settings.focal_x | append: '% ' | append: block.settings.focal_y | append: '%'
              else
                assign pos = focal
              endif
              assign zoom = block.settings.zoom | default: 100
              assign fstyle = 'object-position:' | append: pos
              if zoom > 100
                assign scale = zoom | divided_by: 100.0
                assign fstyle = fstyle | append: ';transform:scale(' | append: scale | append: ');transform-origin:' | append: pos
              endif
            -%}
            <div class="ce-statement__slide" data-st-slide {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1600 | image_tag:
                  loading: 'lazy', sizes: '100vw',
                  widths: '600, 900, 1200, 1600',
                  style: fstyle,
                  alt: block.settings.image.alt | escape }}
              {%- else -%}
                <div class="ce-ph" style="background:#1c1c1c;"></div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if s.show_arrows -%}
          <button class="ce-statement__nav ce-statement__nav--prev" type="button" data-st-prev aria-label="Previous photo">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2"/></svg>
          </button>
          <button class="ce-statement__nav ce-statement__nav--next" type="button" data-st-next aria-label="Next photo">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2"/></svg>
          </button>
        {%- endif -%}
        <span class="ce-statement__count" data-st-count>1/{{ section.blocks.size }}</span>
        <div class="ce-statement__dots" data-st-dots>
          {%- for block in section.blocks -%}
            <button class="ce-statement__dot{% if forloop.first %} is-active{% endif %}" type="button" data-st-dot aria-label="Go to photo {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      </div>
    {%- elsif s.image != blank -%}
      {{ s.image | image_url: width: 2400 | image_tag:
        loading: 'lazy', sizes: '100vw',
        widths: '800, 1200, 1600, 2000, 2400',
        alt: s.image.alt | default: s.heading | escape }}
    {%- else -%}
      <div class="ce-ph" style="background:#1c1c1c;"></div>
    {%- endif -%}
  </div>

  <div class="ce-statement__panel">
    <div class="ce-statement__left">
      {%- if s.index != blank -%}<span class="ce-index ce-reveal">{{ s.index | escape }}</span>{%- endif -%}
      {%- if s.caption != blank -%}
        <p class="ce-statement__caption ce-reveal" data-delay="1">{{ s.caption | escape }}</p>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <a class="ce-btn ce-btn--ink ce-reveal" data-delay="2"
          {% if s.button_link != blank %}href="{{ s.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
          {{ s.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
    <div class="ce-statement__right">
      {%- if s.label != blank -%}<span class="ce-label ce-reveal">{{ s.label | escape }}</span>{%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="ce-statement__heading ce-reveal" data-delay="1">{{ s.heading | escape }}</h2>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Statement panel",
  "tag": "section",
  "class": "ce-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Single image", "info": "Used only when no carousel photos are added below." },
    { "type": "text", "id": "index", "label": "Index", "default": "02" },
    { "type": "textarea", "id": "caption", "label": "Caption (left)", "default": "We don't react to trends. We decide what's next." },
    { "type": "text", "id": "label", "label": "Label (right, above heading)", "default": "Vision" },
    { "type": "text", "id": "heading", "label": "Heading (big word)", "default": "Creative Direction" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Photo carousel" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows on hover", "default": true },
    { "type": "range", "id": "autoplay_speed", "min": 0, "max": 8, "step": 1, "unit": "s", "label": "Auto-advance (0 = off)", "default": 4 },
    {
      "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover",
      "options": [
        { "value": "cover", "label": "Fill frame (crop)" },
        { "value": "contain", "label": "Fit whole photo" }
      ]
    },
    {
      "type": "select", "id": "carousel_ratio", "label": "Frame shape", "default": "default",
      "options": [
        { "value": "default", "label": "Wide (16:7)" },
        { "value": "standard", "label": "Standard (16:9)" },
        { "value": "cinematic", "label": "Cinematic (21:9)" },
        { "value": "tall", "label": "Tall (3:2)" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select", "id": "focal", "label": "Framing (focal point)", "default": "center",
          "info": "Which part of the photo stays in frame when cropped. Choose Manual to use the sliders below.",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" },
            { "value": "top left", "label": "Top-left" },
            { "value": "top right", "label": "Top-right" },
            { "value": "bottom left", "label": "Bottom-left" },
            { "value": "bottom right", "label": "Bottom-right" },
            { "value": "manual", "label": "Manual (use sliders)" }
          ]
        },
        { "type": "range", "id": "focal_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Manual: horizontal", "default": 50, "info": "Used when Framing = Manual. 0 = left, 100 = right." },
        { "type": "range", "id": "focal_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Manual: vertical", "default": 50, "info": "0 = top, 100 = bottom." },
        { "type": "range", "id": "zoom", "min": 100, "max": 200, "step": 5, "unit": "%", "label": "Zoom", "default": 100, "info": "Zooms toward the focal point." }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Statement panel" }]
}
{% endschema %}
