{% comment %}
  Create+Everyday — Editorial cards (Agentura "01/002/003" row)
  Section intro (label + heading + note) over a 3-up grid of numbered
  cards: grayscale image, index, title, caption. Block-based. Styles in
  assets/ce-agentura.css.
{% endcomment %}
{%- liquid
  assign s = section.settings
-%}
<section class="ce-edcards" {{ section.shopify_attributes }}>
  {%- if s.label != blank or s.heading != blank or s.note != blank -%}
    <div class="ce-edcards__head">
      <div>
        {%- if s.label != blank -%}<span class="ce-label ce-label--accent ce-reveal">{{ s.label | escape }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="ce-display ce-reveal" data-delay="1" style="margin-top:1.2rem;">{{ s.heading | escape }}</h2>{%- endif -%}
      </div>
      {%- if s.note != blank -%}<p class="ce-edcards__note ce-label ce-reveal" data-delay="2">{{ s.note | escape | newline_to_br }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="ce-edcards__grid">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <article class="ce-edcard ce-reveal" data-delay="{{ forloop.index0 | modulo: 3 }}" {{ block.shopify_attributes }}>
        <a class="ce-edcard__link" {% if b.link != blank %}href="{{ b.link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
          <div class="ce-edcard__media">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 1200 | image_tag:
                loading: 'lazy', sizes: '(min-width:990px) 33vw, 100vw',
                widths: '400, 600, 800, 1200', alt: b.image.alt | default: b.title | escape }}
            {%- else -%}
              <div class="ce-ph" style="position:absolute;inset:0;background:#1c1c1c;"></div>
            {%- endif -%}
          </div>
          <div class="ce-edcard__row">
            <h3 class="ce-edcard__title">{{ b.title | escape }}</h3>
            {%- if b.index != blank -%}<span class="ce-edcard__index ce-index">{{ b.index | escape }}</span>{%- endif -%}
          </div>
          {%- if b.caption != blank -%}<p class="ce-edcard__caption ce-label ce-label--dim">{{ b.caption | escape }}</p>{%- endif -%}
        </a>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Editorial cards",
  "tag": "section",
  "class": "ce-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow label", "default": "Selected work" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A collection of obsessions" },
    { "type": "textarea", "id": "note", "label": "Note (right)", "default": "We don't wait for the right brief.\nWe write it." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "index", "label": "Index", "default": "001" },
        { "type": "text", "id": "title", "label": "Title", "default": "The mark that stays" },
        { "type": "textarea", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Editorial cards",
      "blocks": [
        { "type": "card", "settings": { "index": "001", "title": "The mark that stays" } },
        { "type": "card", "settings": { "index": "002", "title": "Fashion is dead. Long live fashion." } },
        { "type": "card", "settings": { "index": "003", "title": "Why visual silence is the ultimate authority" } }
      ]
    }
  ]
}
{% endschema %}
